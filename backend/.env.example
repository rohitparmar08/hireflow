# Django Core Settings
DJANGO_SECRET_KEY=change-me-in-production-super-secret-key-32-chars-min
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local

# Database Configuration
# Local dev default (SQLite fallback): leave blank or use sqlite:///db.sqlite3
# Production (PostgreSQL): postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=sqlite:///db.sqlite3

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
