# ==============================================================
# HireFlow Backend Environment Configuration
# Copy this file to .env and supply environment-specific values
# ==============================================================

# Django Core
DJANGO_SECRET_KEY=generate-a-50-character-random-secret-key-for-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.hireflow.com
DJANGO_SETTINGS_MODULE=config.settings.production

# Database Configuration
# Local SQLite default: sqlite:///db.sqlite3
# Production PostgreSQL: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://hireflow_user:securepassword@localhost:5432/hireflow

# CORS & CSRF Security (Comma-separated)
CORS_ALLOWED_ORIGINS=https://app.hireflow.com,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://app.hireflow.com,http://localhost:3000

# SSL & Cookie Security (Set True when serving behind HTTPS)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Gunicorn Process Configuration
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
