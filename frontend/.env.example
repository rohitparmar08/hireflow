# API Base URL
# Local development default: http://localhost:8000/api/v1
# Production (same domain / Nginx reverse proxy): /api/v1
# Production (independent backend domain): https://api.hireflow.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
