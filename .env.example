# ==========================================
# HireFlow Root Environment Configuration Template
# Copy to appropriate subfolder .env files
# ==========================================

# --- Backend (hireflow/backend/.env) ---
DJANGO_SECRET_KEY=change-me-in-production-super-secret-key-32-chars-min
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local

# Database (PostgreSQL URL for production, SQLite for local fallback)
DATABASE_URL=sqlite:///db.sqlite3

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (hireflow/frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
